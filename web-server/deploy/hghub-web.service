[Unit]
Description=HGhub private web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hghub
Group=hghub
WorkingDirectory=/opt/hghub
ExecStart=/opt/hghub/hghub-web
Environment=HG_BIND=127.0.0.1:8900
Environment=HG_DIST=/opt/hghub/dist-web
Environment=HG_DATA_DIR=/var/lib/hghub
Environment=HG_PASSWORD_FILE=/etc/hghub/password
EnvironmentFile=/etc/hghub/server.env
Restart=on-failure
RestartSec=5
StateDirectory=hghub
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hghub

[Install]
WantedBy=multi-user.target
